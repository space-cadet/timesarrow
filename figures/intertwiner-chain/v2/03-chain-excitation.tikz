\begin{tikzpicture}
  % =========================================================================
  % Compact, refined tensor styles local to the chain figure
  % =========================================================================
  \tikzset{
    smalltensor/.style={
      tensor,
      minimum size=5.6mm,
      line width=0.82pt,
      font=\fontsize{7.8}{9}\selectfont,
      drop shadow={opacity=0.11, shadow xshift=0.35pt, shadow yshift=-0.55pt, fill=ink}
    },
    smallsinglet/.style={
      singlet,
      minimum width=5.4mm,
      minimum height=4.3mm,
      rounded corners=1.6pt,
      line width=0.82pt,
      font=\fontsize{8.0}{9}\selectfont,
      drop shadow={opacity=0.10, shadow xshift=0.35pt, shadow yshift=-0.55pt, fill=ink}
    },
    smalltriplet/.style={
      triplet,
      minimum width=5.8mm,
      minimum height=4.6mm,
      rounded corners=1.6pt,
      line width=0.92pt,
      font=\fontsize{8.0}{9}\selectfont,
      drop shadow={opacity=0.13, shadow xshift=0.35pt, shadow yshift=-0.55pt, fill=ink}
    },
    smallleg/.style={font=\fontsize{8.5}{10}\selectfont, text=ink},
    smallphys/.style={font=\fontsize{8.5}{10}\selectfont, text=violet},
    smallspinlbl/.style={font=\fontsize{8.8}{10}\selectfont, text=amberText}
  }

  % =========================================================================
  % Panel (a): 3D Boerdijk-Coxeter chain of 5 face-glued quantum tetrahedra
  % T_i = (V_{i-1}, V_i, V_{i+1}, V_{i+2}), shared faces F_{i,i+1} = (V_i, V_{i+1}, V_{i+2})
  % =========================================================================
  \begin{scope}[yshift=3.45cm]
    \node[paneltag, anchor=west] at (-7.45, 1.96) {(a)};

    % 3-rail 3D projection: Top (k=0,3,6), Bottom-Front (k=1,4,7), Mid-Back (k=2,5)
    \coordinate (V0) at (-7.175,  1.24);
    \coordinate (V1) at (-5.125, -1.12);
    \coordinate (V2) at (-3.075, -0.22);
    \coordinate (V3) at (-1.025,  1.24);
    \coordinate (V4) at ( 1.025, -1.12);
    \coordinate (V5) at ( 3.075, -0.22);
    \coordinate (V6) at ( 5.125,  1.24);
    \coordinate (V7) at ( 7.175, -1.12);

    % Exact centroids of the 5 tetrahedra (intertwiner nodes)
    \coordinate (G1) at (-4.100,  0.29);
    \coordinate (G2) at (-2.050, -0.30);
    \coordinate (G3) at ( 0.000, -0.08);
    \coordinate (G4) at ( 2.050,  0.29);
    \coordinate (G5) at ( 4.100, -0.30);

    % Exact centroids of the 4 internal shared triangular faces (edge blocks)
    \coordinate (F1) at (-3.075, -0.03);
    \coordinate (F2) at (-1.025, -0.03);
    \coordinate (F3) at ( 1.025, -0.03);
    \coordinate (F4) at ( 3.075, -0.03);

    % End-face centroids for chain continuation
    \coordinate (FL) at (-5.125, -0.03);
    \coordinate (FR) at ( 5.125, -0.03);

    % 1. Back faces & dashed back wireframe of the tetrahelix
    \fill[tetFace, opacity=0.11] (V0) -- (V3) -- (V2) -- cycle;
    \fill[tetFace, opacity=0.11] (V3) -- (V6) -- (V5) -- cycle;
    \fill[tetFace, opacity=0.09] (V1) -- (V4) -- (V2) -- cycle;
    \fill[tetFace, opacity=0.09] (V4) -- (V7) -- (V5) -- cycle;
    \fill[tetFace, opacity=0.09] (V2) -- (V3) -- (V5) -- cycle;
    \fill[tetFace, opacity=0.09] (V2) -- (V4) -- (V5) -- cycle;

    \draw[tetEdge, densely dashed, line width=0.5pt, opacity=0.45]
      (V0) -- (V2) -- (V1)
      (V2) -- (V5)
      (V2) -- (V3)
      (V2) -- (V4)
      (V3) -- (V5)
      (V4) -- (V5)
      (V5) -- (V6)
      (V5) -- (V7);

    % 2. Translucent internal shared triangular faces:
    %    teal for singlet faces F12, F23, F45; warm amber for excited face F34 (edge e)
    \fill[tealBot, opacity=0.28] (V1) -- (V2) -- (V3) -- cycle;
    \draw[tealBorder, densely dashed, line width=0.55pt, opacity=0.55] (V1) -- (V2) -- (V3);

    \fill[tealBot, opacity=0.28] (V2) -- (V3) -- (V4) -- cycle;
    \draw[tealBorder, densely dashed, line width=0.55pt, opacity=0.55] (V2) -- (V3) (V2) -- (V4);

    \fill[amberGlow, opacity=0.42] (V3) -- (V4) -- (V5) -- cycle;
    \draw[amberBorder, densely dashed, line width=0.75pt, opacity=0.75] (V3) -- (V5) -- (V4);
    \draw[amberBorder, line width=1.0pt, opacity=0.90] (V3) -- (V4);

    \fill[tealBot, opacity=0.28] (V4) -- (V5) -- (V6) -- cycle;
    \draw[tealBorder, densely dashed, line width=0.55pt, opacity=0.55] (V4) -- (V5) -- (V6);

    % 3. External magnetic legs (u_i, d_i) with face puncture rings
    \foreach \i/\nd/\ux/\uy/\upx/\upy/\dx/\dy/\dpx/\dpy in {
      1/G1/-4.48/1.52/-4.31/0.98/-3.70/-1.56/-3.91/-0.60,
      2/G2/-2.43/1.52/-2.25/0.64/-1.65/-1.56/-1.84/-0.94,
      3/G3/-0.38/1.52/-0.19/0.76/ 0.40/-1.56/ 0.20/-0.82,
      4/G4/ 1.67/1.52/ 1.84/0.98/ 2.45/-1.56/ 2.24/-0.60,
      5/G5/ 3.72/1.52/ 3.90/0.64/ 4.50/-1.56/ 4.31/-0.94
    }{%
      \draw[magnetic] (\nd) -- (\ux,\uy) node[above left=-1.5pt, smallleg] {$u_{\i}$};
      \node[puncture] at (\upx,\upy) {};
      \draw[magnetic] (\nd) -- (\dx,\dy) node[below right=-1.5pt, smallleg] {$d_{\i}$};
      \node[puncture] at (\dpx,\dpy) {};
    }

    % 4. Internal dual helical chain spine through every tetrahedron & shared face
    \draw[magnetic] (-6.35,-0.03) -- (FL) -- (G1) -- (F1) -- (G2) -- (F2) -- (G3) -- (F3) -- (G4) -- (F4) -- (G5) -- (FR) -- (6.35,-0.03);
    \node[puncture] at (FL) {};
    \node[puncture] at (FR) {};
    \node[muted] at (-6.72, -0.03) {$\cdots$};
    \node[muted] at ( 6.72, -0.03) {$\cdots$};

    % 5. Front translucent faces & crisp front wireframe ridges of the tetrahelix
    \fill[tetFace, opacity=0.16] (V0) -- (V1) -- (V3) -- cycle;
    \fill[tetFace, opacity=0.13] (V1) -- (V3) -- (V4) -- cycle;
    \fill[tetFace, opacity=0.16] (V3) -- (V4) -- (V6) -- cycle;
    \fill[tetFace, opacity=0.13] (V4) -- (V6) -- (V7) -- cycle;

    \draw[tetEdge, line width=0.72pt, opacity=0.80]
      (V0) -- (V3) -- (V6)
      (V1) -- (V4) -- (V7)
      (V0) -- (V1) -- (V3)
      (V4) -- (V6) -- (V7);
    \draw[amberBorder, line width=1.05pt, opacity=0.92] (V3) -- (V4);

    % 6. Dashed violet physical orientation stems s_1..s_5 rising cleanly out of each tetrahedron
    \foreach \i/\nd/\sx in {1/G1/-4.100, 2/G2/-2.050, 3/G3/0.000, 4/G4/2.050, 5/G5/4.100}{%
      \draw[physicalHalo] (\nd) -- (\sx, 1.90) node[physdot] {} node[above=2pt, smallphys] {$s_{\i}$};
    }

    % 7. Bold spin-1 excitation leg M rising straight from shared face F34
    \draw[preaction={draw=white, line width=2.5pt, line cap=round}, spinone]
      (F3) -- (1.025, 1.90) node[spinonedot] {} node[above=2pt, smallspinlbl] {$M$};

    % 8. Sleek small intertwiner nodes and edge pairing blocks
    \foreach \i/\nd in {1/G1, 2/G2, 3/G3, 4/G4, 5/G5}{%
      \node[smalltensor] at (\nd) {$I_{\i}$};
    }
    \foreach \fn in {F1, F2, F4}{%
      \node[smallsinglet] at (\fn) {$\epsilon$};
    }
    \node[smalltriplet] (gdef) at (F3) {$E$};
    \node[smallspinlbl, below=3pt] at (gdef.south) {$e$};
  \end{scope}

  % Subtle horizontal divider between geometric view and TN representation
  \draw[rulegray, line width=0.55pt] (-7.45, 1.38) -- (7.45, 1.38);

  % =========================================================================
  % Helper for sleek TN chain sites (aligned vertically with G1..G5 above)
  % =========================================================================
  \newcommand{\sleeksite}[3]{%
    \coordinate (t#1) at (#2,#3);
    \begin{scope}[on background layer]
      \draw[magnetic] (t#1) -- ++(108:0.78) node[above left=-1.5pt, smallleg] {$u_{#1}$};
      \draw[magnetic] (t#1) -- ++(-72:0.78) node[below right=-1.5pt, smallleg] {$d_{#1}$};
    \end{scope}
    \draw[physicalHalo] (t#1) -- ++(0, 1.04) node[physdot] {} node[above=1.5pt, smallphys] {$s_{#1}$};
    \node[smalltensor] (tn#1) at (t#1) {$I_{#1}$};
  }

  % =========================================================================
  % Panel (b): Sleek TN representation — singlet reference chain
  % =========================================================================
  \begin{scope}[yshift=-0.05cm]
    \node[paneltag, anchor=west] at (-7.45, 1.04) {(b)};

    \begin{scope}[on background layer]
      \draw[violet, opacity=0.16, line width=0.45pt, densely dotted] (-4.100, 1.04) -- (4.100, 1.04);
      \draw[magnetic] (-5.25, 0) -- (5.25, 0);
    \end{scope}
    \node[muted] at (-5.62, 0) {$\cdots$};
    \node[muted] at ( 5.62, 0) {$\cdots$};

    \foreach \i/\x in {1/-4.100, 2/-2.050, 3/0.000, 4/2.050, 5/4.100}{%
      \sleeksite{\i}{\x}{0}
    }
    \foreach \x in {-3.075, -1.025, 1.025, 3.075}{%
      \node[smallsinglet] at (\x, 0) {$\epsilon$};
    }
  \end{scope}

  % Light hairline between (b) and (c)
  \draw[rulegray, line width=0.45pt, densely dashed] (-7.45, -1.45) -- (7.45, -1.45);

  % =========================================================================
  % Panel (c): Sleek TN representation — localized triplet insertion on edge e
  % =========================================================================
  \begin{scope}[yshift=-2.95cm]
    \node[paneltag, anchor=west] at (-7.45, 1.04) {(c)};

    \begin{scope}[on background layer]
      \draw[violet, opacity=0.16, line width=0.45pt, densely dotted] (-4.100, 1.04) -- (4.100, 1.04);
      \fill[amberGlow, opacity=0.38, rounded corners=4pt] (0.58, -0.40) rectangle (1.47, 0.40);
      \draw[magnetic] (-5.25, 0) -- (5.25, 0);
    \end{scope}
    \node[muted] at (-5.62, 0) {$\cdots$};
    \node[muted] at ( 5.62, 0) {$\cdots$};

    \foreach \i/\x in {1/-4.100, 2/-2.050, 3/0.000, 4/2.050, 5/4.100}{%
      \sleeksite{\i}{\x}{0}
    }
    \foreach \x in {-3.075, -1.025, 3.075}{%
      \node[smallsinglet] at (\x, 0) {$\epsilon$};
    }
    \draw[spinone] (1.025, 0) -- (1.025, 1.04) node[spinonedot] {} node[above=1.5pt, smallspinlbl] {$M$};
    \node[smalltriplet] (tndef) at (1.025, 0) {$E$};
    \node[smallspinlbl, below=3pt] at (tndef.south) {$e$};
  \end{scope}
\end{tikzpicture}
